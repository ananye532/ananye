# Required for docker compose
POSTGRES_PASSWORD=change-me
# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string-0123456789

# Optional AI enhancement. Leave AI_PROVIDER=none for deterministic-only analysis.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
